{
  "manifest_version": 3,
  "name": "Content Watcher — Watch Together",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Share a video tab with friends. You control playback; everyone watches together.",
  "permissions": ["activeTab", "tabCapture", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": { "default_popup": "popup.html", "default_title": "Watch together" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
